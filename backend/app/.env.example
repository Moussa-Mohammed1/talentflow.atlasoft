# RUNTIME ENVIRONMENT
ENVIRONMENT=development
LOG_LEVEL=INFO

# DATABASE CONNECTION STRING
DATABASE_URL=postgresql://username:password@host:port/dbname
DB_ECHO=false

# BACKEND & FRONTEND URLS / CORS
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SECURITY & SESSION TOKENS (Use >=32 random chars for SECRET_KEY in staging/prod)
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# LLM CONFIGURATION PARAMETERS (SAFE DEFAULTS & GOVERNED ADMIN CONFIG)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_DEFAULT_MODEL=qwen3:8b

# 32-byte URL-safe base64 Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
LLM_CONFIG_ENCRYPTION_KEY=

LLM_DEFAULT_PROVIDER=deepseek
LLM_FALLBACK_PROVIDER=ollama
LLM_DEFAULT_TEMPERATURE=0.1
LLM_DEFAULT_MAX_TOKENS=4096
LLM_DEFAULT_TIMEOUT_SECONDS=60

# OPTIONAL LANGFUSE OBSERVABILITY
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Legacy / compatibility LLM env vars
TALENTFLOW_SKILL_LLM_PROVIDER=deepseek
TALENTFLOW_SKILL_LLM_ENDPOINT=https://api.deepseek.com/v1
TALENTFLOW_SKILL_LLM_MODEL=deepseek-chat
TALENTFLOW_SKILL_LLM_TIMEOUT=2000
TALENTFLOW_SKILL_LLM_NUM_PREDICT=4090
TALENTFLOW_SKILL_LLM_TEMPERATURE=0.8
TALENTFLOW_SKILL_LLM_TOP_P=0.8
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ALLOWED RECRUITERS EMAIL DOMAIN
EMAIL_SUFFIX=gmail.com

# DEFAULT PASSWORD FOR NEW INVITED RECRUITERS
DEFAULT_PASSWORD=

# SYSTEM EMAIL VARIABLES
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

INVITATION_FRONTEND_URL=http://localhost:3000/invitations

# LINKEDIN AUTHENTICATION PARAMETERS
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URL=http://localhost:8000/api/auth/linkedin/callback
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback

# FILE STORAGE (local | s3)
STORAGE_BACKEND=local
STORAGE_ROOT=storage
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=talentflow-storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_SSL=false

# REDIS & DISTRIBUTED WORKER QUEUE (CELERY)
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false
CELERY_PRELOAD_MODELS=true
