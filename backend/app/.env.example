# RUNTIME ENVIRONMENT
ENVIRONMENT=development
LOG_LEVEL=INFO

# DATABASE CONNECTION STRING
DATABASE_URL=postgresql://username:password@host:port/dbname
DB_ECHO=false

# BACKEND & FRONTEND URLS / CORS
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SECURITY & SESSION TOKENS (Use >=32 random chars for SECRET_KEY in staging/prod)
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# LLM CONFIGURATION PARAMETERS
TALENTFLOW_SKILL_LLM_PROVIDER=deepseek
TALENTFLOW_SKILL_LLM_ENDPOINT=https://api.deepseek.com/v1
TALENTFLOW_SKILL_LLM_MODEL=deepseek-chat
TALENTFLOW_SKILL_LLM_TIMEOUT=2000
TALENTFLOW_SKILL_LLM_NUM_PREDICT=4090
TALENTFLOW_SKILL_LLM_TEMPERATURE=0.8
TALENTFLOW_SKILL_LLM_TOP_P=0.8
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ALLOWED RECRUITERS EMAIL DOMAIN
EMAIL_SUFFIX=gmail.com

# DEFAULT PASSWORD FOR NEW INVITED RECRUITERS
DEFAULT_PASSWORD=

# SYSTEM EMAIL VARIABLES
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

INVITATION_FRONTEND_URL=http://localhost:3000/invitations

# LINKEDIN AUTHENTICATION PARAMETERS
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URL=http://localhost:8000/api/auth/linkedin/callback
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback

# FILE STORAGE (local | s3)
STORAGE_BACKEND=local
STORAGE_ROOT=storage
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=talentflow-storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_SSL=false

# REDIS & DISTRIBUTED WORKER QUEUE (CELERY)
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false
CELERY_PRELOAD_MODELS=true
